#!/usr/bin/env ruby
# frozen_string_literal: true

# Evaluates a renewal against Washington's Apple Health for Adults fact graph.
#
#   bin/evaluate examples/maya_claimed_by_parents.json
#   echo '{"renewer": {"renewal_month": "2027-03"}}' | bin/evaluate
#   bin/evaluate --fact work_requirement.meets_work_requirement examples/eligible_student.json
#
# Reads JSON from the file given, or from stdin. Writes JSON to stdout. See README.md for the input
# format and lib/wa_hr1/json_output.rb for the output.

require "optparse"
require_relative "../lib/wa_hr1"
require_relative "../lib/wa_hr1/json_output"

target = WaHr1::JsonOutput::DEFAULT_TARGET
compact = false
OptionParser.new do |opts|
  opts.banner = "Usage: bin/evaluate [options] [input.json]"
  opts.on("--fact MODULE.FACT", "Fact whose missing inputs become next_questions (default: eligibility.likely_eligible)") do |fact|
    target = fact.split(".", 2).map(&:to_sym)
  end
  opts.on("--compact", "Print JSON on one line") { compact = true }
end.parse!

begin
  input = JSON.parse(ARGF.read, symbolize_names: true)
rescue JSON::ParserError => e
  warn "Input isn't valid JSON: #{e.message}"
  exit 1
end

unless input.is_a?(Hash)
  warn "Input must be a JSON object"
  exit 1
end

output = WaHr1::JsonOutput.evaluate(input, target:)
puts compact ? JSON.generate(output) : JSON.pretty_generate(output)
